# Obrigatória: chave do Google Cloud com Geocoding API + Routes API habilitadas
GOOGLE_MAPS_API_KEY=

# Endereço da loja (origem de todas as rotas)
ENDERECO_ORIGEM=R. José Barros Magaldi, 1247 - Jardim São João, São Paulo - SP, 05815-010

# Vazia = endpoint aberto. Preenchida = exige header X-API-Key com esse valor.
